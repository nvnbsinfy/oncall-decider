# Bedrock generative model for summaries. Leave unset / keep mock to run offline.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Hugging Face id for the local decision model (Apache 2.0).
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19

# Below this confidence, triage asks a human to confirm (0.0 - 1.0).
TRIAGE_CONFIRM_THRESHOLD=0.60

# Set to 1 if downloads hang behind a restrictive proxy.
HF_HUB_DISABLE_XET=1

# Optional: human-validated ServiceNow incident creation.
# Off unless SNOW_ENABLED=1 AND all three credential values are set.
# When on, each ticket the agent files stops for a human choice:
# create the incident in ServiceNow, or no incident.
SNOW_ENABLED=0
SN_INSTANCE=https://dev123456.service-now.com
SN_USER=
SN_PASSWORD=
